# ===================================================================
# IdeaForge AI - environment variables (PLACEHOLDERS ONLY)
# Copy to .env.local for local development (vercel dev), and add the
# same names in Vercel > Project > Settings > Environment Variables.
# NEVER commit real keys.
# ===================================================================

# ---------- AI provider (server-side only, never exposed to browser) ----------
# Choose one: gemini | openai | anthropic
AI_PROVIDER=gemini

# Google Gemini (has a free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (paid) - https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (paid) - https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: require a signed-in Supabase user before AI calls are allowed.
# Strongly recommended once the app is public, so strangers cannot spend your AI quota.
AI_REQUIRE_AUTH=false

# ---------- Supabase (OPTIONAL - accounts + cloud saving) ----------
# Public values (safe in the browser, protected by Row Level Security)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Same values for the server (used only to verify login tokens when AI_REQUIRE_AUTH=true)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Do NOT add the Supabase service_role key anywhere in this app. It is not needed.
